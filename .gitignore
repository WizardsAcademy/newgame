# Godot 4+ cache (regenerates automatically)
.godot/

# Godot 3 legacy cache (harmless, just in case)
.import/

# Exported builds (when we export the game later)
export/
build/

# OS junk files
.DS_Store
Thumbs.db
desktop.ini

# Editor backup files
*.tmp
*.bak

# Godot AI plugin update-tooling scratch data
addons/.godot_ai_update/

# Python bytecode from the sprite generators
tools/__pycache__/
