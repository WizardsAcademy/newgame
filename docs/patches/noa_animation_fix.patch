--- a/tools/import_pose_sheet.py
+++ b/tools/import_pose_sheet.py
@@ -551,6 +551,106 @@ def place_pose_in_cell(
 # Frame synthesis helpers (breath, directional stride, charge, hurt, die)
 # ---------------------------------------------------------------------------
 
+def make_mirrored_stride(
+    source_cell: Image.Image,
+    ground_y: int = GROUND_Y,
+    bob: int = 0,
+) -> Image.Image:
+    """Opposite-foot stride frame from ONE drawn side view.
+
+    Mirrors only the lower body about the body's vertical centre line so the
+    planted leg and the trailing leg swap, while the torso, head, crown and
+    cloak mass keep their TRUE silhouette (no global flip - a global flip would
+    move the crown, the hair fall and the weapon to the wrong side).
+    """
+    bb = source_cell.getbbox()
+    if bb is None:
+        raise ValueError("mirror stride: empty cell")
+    split_y = ground_y - int((ground_y - bb[1]) * 0.30)
+    mid_x = (bb[0] + bb[2]) // 2
+
+    out = Image.new("RGBA", (CELL, CELL), (0, 0, 0, 0))
+    # `bob` shifts the torso up, so the upper crop must extend DOWN by `bob`
+    # pixels or a 1px transparent band opens at the seam (verified bug).
+    upper = source_cell.crop((0, 0, CELL, split_y + bob))
+    out.alpha_composite(upper, (0, 0))
+
+    lower = source_cell.crop((bb[0], split_y, bb[2], ground_y))
+    flipped = lower.transpose(Image.Transpose.FLIP_LEFT_RIGHT)
+    out.alpha_composite(flipped, (bb[0] + (bb[2] - bb[0]) - flipped.width, split_y))
+    return out
+
+
+def make_contact_frame(source_cell: Image.Image, ground_y: int = GROUND_Y) -> Image.Image:
+    """Second contact pose: 1px vertical compression of the stride, feet planted.
+
+    This is the 'down' beat of a walk cycle - the body dips as weight lands.
+    Only the upper body moves; the boot contact rows stay exactly on ground_y.
+    """
+    bb = source_cell.getbbox()
+    if bb is None:
+        raise ValueError("contact frame: empty cell")
+    split_y = ground_y - int((ground_y - bb[1]) * 0.20)
+    out = Image.new("RGBA", (CELL, CELL), (0, 0, 0, 0))
+    out.alpha_composite(source_cell.crop((0, split_y, CELL, CELL)), (0, split_y))
+    out.alpha_composite(source_cell.crop((0, 0, CELL, split_y)), (0, 1))
+    return out
+
+
+def make_recoil_frame(source_cell: Image.Image, ground_y: int = GROUND_Y) -> Image.Image:
+    """Hit reaction from a DRAWN pose - a 1px back-shunt, never a squash or shear.
+
+    Reusing the drawn lunge/recoil silhouette keeps every pixel hand-authored;
+    the flinch is expressed by translating the whole body 1px away from the hit
+    and darkening the outline, which reads at 96px and cannot smear.
+    """
+    bb = source_cell.getbbox()
+    if bb is None:
+        raise ValueError("recoil frame: empty cell")
+    out = Image.new("RGBA", (CELL, CELL), (0, 0, 0, 0))
+    out.alpha_composite(source_cell, (+1, 0))
+
+    px = out.load()
+    obb = out.getbbox()
+    if obb is not None:
+        # Re-ink the leading 1px column so the shove reads as impact, not a slide.
+        for y in range(obb[1], min(obb[3], ground_y)):
+            for x in range(CELL):
+                if px[x, y][3] > 0:
+                    if 0 <= x - 1 < CELL and px[x - 1, y][3] == 0:
+                        px[x - 1, y] = C_SELOUT
+                    break
+    return out
+
+
+def make_kneeling_collapse(idle_cell: Image.Image, ground_y: int = GROUND_Y) -> Image.Image:
+    """Death frame: the standing silhouette sunk into the hem, NOT rotated.
+
+    Rotating a pixel-art pose destroys its pixel grid (verified: rotate -76 deg
+    then rescale turns the figure into a grey smear with a broken alpha edge).
+    Instead the whole authored body is translated down behind a rising crimson
+    dissolve line, which is how 96px pixel games show a collapse.
+    """
+    bb = idle_cell.getbbox()
+    if bb is None:
+        raise ValueError("collapse frame: empty cell")
+    sink = 10
+    out = Image.new("RGBA", (CELL, CELL), (0, 0, 0, 0))
+    body = idle_cell.crop((0, bb[1], CELL, ground_y))
+    out.alpha_composite(body, (0, bb[1] + sink))
+
+    px = out.load()
+    dissolve_y = ground_y - 16
+    for y in range(dissolve_y, CELL):
+        for x in range(CELL):
+            if px[x, y][3] == 0:
+                continue
+            # Fade the lower body into a crimson floor pool, row by row.
+            depth = (y - dissolve_y) / float(max(CELL - dissolve_y - 1, 1))
+            if depth > 0.55:
+                px[x, y] = C_CRIMSON_DARK if (x + y) % 3 else C_SELOUT
+    return out
+
 def make_breath_variant(base_cell: Image.Image, ground_y: int = GROUND_Y) -> Image.Image:
     """Subtle 1px upper-body breathing bob while feet & hem stay planted at ground_y."""
     bb = base_cell.getbbox()
@@ -1018,9 +1118,6 @@ def import_noa(cfg: dict) -> None:
     pose_files = {
         "idle_down": "idle down.png",
