extends Node2D
class_name ArcherVisuals
## Everything the archer LOOKS like: the 12-pose skeleton sheet, the shamble,
## the bow draw / release, the grating idle rattle, the mocking head tilt and
## the collapse into a bone heap.
##
## WHY THIS FILE EXISTS (same split as SlimeVisuals)
##   `archer.gd` answers "what should the archer DO?" (keep distance, aim,
##   fire, take damage, die). This file answers "what should it LOOK like?".
##   The AI calls a handful of short methods and this script owns every
##   pixel, wobble and tween. No gameplay number lives in here - the archer's
##   HP, speed, damage, aim time and cooldowns are untouched by the redesign.
##
## THE SHEET (assets/textures/archer_skeleton.png, generated by
## tools/make_archer_sprites.py - run that file, never hand-edit the PNG)
##   12 columns x 2 rows of 32x32 frames.
##   row 0 = coloured poses, in the order of the `Pose` enum below
##   row 1 = the SAME poses as pure-white silhouettes
##           -> the hit flash is simply `frame += 12` for 0.1 s.
##
## WHY "ANNOYING" IS VISUAL-ONLY
##   The player asked for an enemy that gets on your nerves. That is sold
##   entirely with motion: a bony shamble that lags behind the movement, a
##   rattle every couple of seconds, a slow mocking head tilt after a shot.
##   None of it changes hitboxes, speed or damage - the AI tests keep
##   expecting exactly the same numbers.

# ---------------------------------------------------------------------------
# Sheet layout  (see tools/make_archer_sprites.py)
# ---------------------------------------------------------------------------
## Frames per row = the 12 poses.
const ROW_FRAMES: int = 12

## The white silhouettes sit exactly one row below their coloured poses.
const WHITE_ROW_OFFSET: int = 12

## Frame indices inside row 0. Keep in sync with POSES in the generator.
enum Pose {
	IDLE_A = 0,      # resting shamble, shoulders down
	IDLE_B,          # resting shamble, "breath" (the hood lifts a pixel)
	RATTLE,          # bones clack: shoulders up, jaw open
	WALK_A,          # step, left foot forward
	WALK_B,          # step, right foot forward
	DRAW,            # bow coming up, string half pulled
	FULL_DRAW,       # string at the cheek, embers hot
	RELEASE,         # string snapped forward, arms flung
	MOCK,            # mocking head tilt - the annoying one
	HURT,            # flinch, hood knocked back
	COLLAPSE,        # knees fold, going down
	BONES,           # the heap that is left behind
}

## What the visual state machine is doing. LOCOMOTION is the only state that
## cycles; the others hold a pose until the AI (or a timer) says otherwise.
enum Mode { LOCOMOTION, DRAW, RELEASE, MOCK, HURT, DEAD }

# ---------------------------------------------------------------------------
# Feel. Safe to tweak in the Inspector.
# ---------------------------------------------------------------------------
## Seconds per walk frame - a slow, dragging shamble.
@export var walk_frame_time: float = 0.13
## How far the body bobs while walking, in pixels.
@export var walk_bob: float = 1.5
## Idle breathing speed (radians per second).
@export var breath_speed: float = 2.0
## Seconds between idle rattles, min/max. This is the "grating" bit: it makes
## the archer feel like it can never stand still.
@export var rattle_interval_min: float = 2.4
@export var rattle_interval_max: float = 5.0
## How long one rattle lasts.
@export var rattle_time: float = 0.18
## How long the release pose is held before falling back to locomotion.
@export var release_time: float = 0.14
## How long the mock head tilt is held.
@export var mock_time: float = 0.34
## How long the hurt flinch is held.
@export var hurt_time: float = 0.16
## How long the collapse pose plays before the bone heap appears.
@export var collapse_time: float = 0.14
## How long the white silhouette stays on after a hit.
@export var flash_time: float = 0.1
## Tremble amplitude while the bow is drawn. Purely cosmetic.
@export var draw_tremble: float = 0.5

# ---------------------------------------------------------------------------
# Nodes
# ---------------------------------------------------------------------------
@onready var body: Sprite2D = $Body
@onready var shadow: Sprite2D = $Shadow

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
var _mode: Mode = Mode.LOCOMOTION
var _pose: int = Pose.IDLE_A
var _facing: int = 1
var _moving: bool = false

var _flash_left: float = 0.0
var _mode_time: float = 0.0

## Idle clocks: breath, rattle countdown, and the walk animation timer.
var _idle_time: float = 0.0
var _rattle_in: float = 3.0
var _rattle_left: float = 0.0
var _walk_time: float = 0.0

## Cosmetic offsets applied on top of the pose art.
var _shake_x: float = 0.0
var _lift_y: float = 0.0

## Coloured row of the sheet (0). Kept as a variable so a future skeletal
## variant ("armoured archer", "hero archer") can point at another row pair.
var _row: int = 0


func _ready() -> void:
	# A random first rattle so a wave of archers never clacks in lockstep.
	_rattle_in = randf_range(rattle_interval_min, rattle_interval_max)
	_apply()


func _process(delta: float) -> void:
	_flash_left = maxf(0.0, _flash_left - delta)
	_mode_time += delta

	match _mode:
		Mode.LOCOMOTION:
			_update_locomotion(delta)
		Mode.DRAW:
			_update_draw()
		Mode.RELEASE:
			_update_hold(Pose.RELEASE, release_time)
		Mode.MOCK:
			_update_hold(Pose.MOCK, mock_time)
		Mode.HURT:
			_update_hold(Pose.HURT, hurt_time)
		Mode.DEAD:
			_update_dead()

	_apply()


# =====================================================================
# PUBLIC API - the only calls archer.gd is allowed to make
# =====================================================================

## Look left/right. Pass any non-zero x (the art faces RIGHT by default).
func set_facing(x: float) -> void:
	if absf(x) < 0.01:
		return
	_facing = -1 if x < 0.0 else 1


## "Am I walking right now?" Safe to call every physics frame - it only
## reacts to a real change, so it never resets the walk cycle mid-step.
func set_moving(moving: bool) -> void:
	if moving == _moving:
		return
	_moving = moving
	_walk_time = 0.0
	if not moving:
		_lift_y = 0.0


## The bow draw, driven by the AI's own timer. `progress` 0..1: the first
## two thirds show the bow coming up, the last third the string at the
## cheek with a nervous tremble. Called every physics frame while aiming.
func play_draw(progress: float) -> void:
	if _mode != Mode.DRAW:
		_mode = Mode.DRAW
		_mode_time = 0.0
	_pose = Pose.FULL_DRAW if progress >= 0.62 else Pose.DRAW


## The arrow left the bow. Short, punchy; falls back on its own.
func play_release() -> void:
	_mode = Mode.RELEASE
	_mode_time = 0.0
	_pose = Pose.RELEASE
	_shake_x = 0.0
	_lift_y = 0.0


## The taunt: a slow mocking head tilt. Used sparingly - after a shot the
## player actually dodged, and occasionally while circling.
func play_mock() -> void:
	if _mode == Mode.DEAD:
		return
	_mode = Mode.MOCK
	_mode_time = 0.0
	_pose = Pose.MOCK
	_shake_x = 0.0
	_lift_y = 0.0


## A short flinch when hit. Does not touch the game state.
func play_hurt() -> void:
	if _mode == Mode.DRAW:
		return
	_mode = Mode.HURT
	_mode_time = 0.0
	_pose = Pose.HURT


## Collapse into a heap of bones. The node stays where it is; `archer.gd`
## only fades it out.
func play_death() -> void:
	_mode = Mode.DEAD
	_mode_time = 0.0
	_pose = Pose.COLLAPSE
	_shake_x = 0.0
	_lift_y = 0.0
	_spawn_bone_chips()


## Paint the archer pure white for a moment (the hit flash).
func flash(duration: float = -1.0) -> void:
	var length: float = flash_time if duration < 0.0 else duration
	_flash_left = maxf(_flash_left, length)


## True while the white silhouette is showing.
func is_flashing() -> bool:
	return _flash_left > 0.0


## Which row pair of the sheet to draw from. 0 today; kept for variants.
func set_variant_row(row: int) -> void:
	_row = maxi(0, row)
	_apply()


# =====================================================================
# LOCOMOTION (breathing, shamble, rattle)
# =====================================================================

func _update_locomotion(delta: float) -> void:
	_idle_time += delta

	if _moving:
		# Walk: two frames, one bob, and a small lean into the step so the
		# shamble does not read as a sprite sliding along the floor.
		_walk_time += delta
		var step: int = int(_walk_time / maxf(walk_frame_time, 0.001)) % 2
		_pose = Pose.WALK_A if step == 0 else Pose.WALK_B
		_lift_y = walk_bob * absf(sin(_walk_time * PI / maxf(walk_frame_time, 0.001)))
		_shake_x = 0.0
		_rattle_in = randf_range(rattle_interval_min, rattle_interval_max)
		_rattle_left = 0.0
		return

	# Standing: a slow "breath" between the two idle frames.
	_walk_time = 0.0
	_lift_y = 0.0
	var breath: float = (sin(_idle_time * breath_speed) + 1.0) * 0.5
	_pose = Pose.IDLE_B if breath > 0.5 else Pose.IDLE_A

	# The rattle: every few seconds the skeleton clacks its bones and lifts
	# its shoulders. Pure noise - and the reason it never feels at rest.
	if _rattle_left > 0.0:
		_rattle_left -= delta
		_pose = Pose.RATTLE
		_shake_x = sin(_idle_time * 60.0) * 1.0
	elif _rattle_in > 0.0:
		_rattle_in -= delta
	else:
		_rattle_left = rattle_time
		_rattle_in = randf_range(rattle_interval_min, rattle_interval_max)
		_spawn_rattle_dust()


func _update_draw() -> void:
	_lift_y = 0.0
	# Trembling builds as the string comes back - tension you can see.
	var tension: float = clampf(_mode_time / 0.35, 0.0, 1.0)
	_shake_x = sin(_mode_time * 46.0) * draw_tremble * tension


func _update_hold(pose: int, duration: float) -> void:
	_lift_y = 0.0
	_pose = pose
	if _mode_time >= duration:
		_mode = Mode.LOCOMOTION
		_mode_time = 0.0
		_walk_time = 0.0


func _update_dead() -> void:
	_lift_y = 0.0
	_shake_x = 0.0
	_pose = Pose.COLLAPSE if _mode_time < collapse_time else Pose.BONES


# =====================================================================
# APPLYING THE LOOK
# =====================================================================

## Writes the state onto the nodes. Called once per rendered frame - never
## per physics frame - so the motion stays smooth even if physics ticks.
func _apply() -> void:
	if body == null:
		return

	var row: int = _row * 2
	body.frame = (row * ROW_FRAMES
			+ (WHITE_ROW_OFFSET if _flash_left > 0.0 else 0)
			+ _pose)
	body.flip_h = _facing < 0
	body.position = Vector2(_shake_x, -_lift_y)

	# The shadow shrinks a touch as the body lifts - the cheapest way to sell
	# height on a top-down floor without touching the collision shape.
	if shadow != null:
		var lift: float = clampf(_lift_y / maxf(walk_bob, 0.001), 0.0, 1.0)
		shadow.scale = Vector2(0.8, 0.28) * lerpf(1.0, 0.88, lift)


# =====================================================================
# JUICE - tiny particle bursts made in code (no extra scene files)
# =====================================================================

## A puff of bone dust when the skeleton rattles.
func _spawn_rattle_dust() -> void:
	_spawn_particles(3, 0.3, Color(0.86, 0.84, 0.72, 0.7), 12.0, 28.0, 70.0)


## Bone chips flying off the collapsing pile. Parented to the arena: the
## archer itself is queue_free()d a moment later.
func _spawn_bone_chips() -> void:
	_spawn_particles(10, 0.45, Color(0.81, 0.78, 0.67, 1.0), 40.0, 90.0, 100.0)


func _spawn_particles(amount: int, life: float, colour: Color,
		speed_min: float, speed_max: float, spread: float) -> void:
	var parent: Node = get_parent()
	if parent == null:
		return

	var burst := CPUParticles2D.new()
	burst.one_shot = true
	burst.amount = amount
	burst.lifetime = life
	burst.explosiveness = 1.0
	burst.direction = Vector2.UP
	burst.spread = spread
	burst.gravity = Vector2(0.0, 220.0)
	burst.initial_velocity_min = speed_min
	burst.initial_velocity_max = speed_max
	burst.scale_amount_min = 1.0
	burst.scale_amount_max = 2.0
	burst.color = colour
	burst.emitting = false
	parent.add_child(burst)
	burst.global_position = global_position + Vector2(0.0, 2.0)
	burst.emitting = true
	burst.finished.connect(burst.queue_free)
