extends Node2D
class_name GolemVisuals
## Everything the stone golem LOOKS like: the 12-pose brute sheet, the heavy
## stomp cycle, the arm-raise telegraph, the slam and its floor crack, the
## stuck-in-the-ground recovery, the elite "uprising" flare and the crumble.
##
## WHY THIS FILE EXISTS (same split as SlimeVisuals / ArcherVisuals)
##   `golem.gd` answers "what should the golem DO?" (chase, telegraph, slam,
##   recover, die). This file answers "what should it LOOK like?". The AI calls
##   a handful of short methods and this file owns every pixel, wobble, dust
##   puff and footstep shake. No combat number lives in here.
##
## THE SHEET (assets/textures/golem_stone.png, generated by
## tools/make_golem_sprites.py - run that file, never hand-edit the PNG)
##   12 columns x 2 rows of 40x40 frames.
##   row 0 = coloured poses, in the order of the `Pose` enum below
##   row 1 = the SAME poses as pure-white silhouettes
##           -> the hit flash is simply `frame += 12` for 0.1 s.
##
## WHY IT FEELS HEAVY  (this is the whole point of the redesign)
##   Weight is sold with TIMING, not with more pixels: the walk cycle holds
##   each planted foot for a beat, the whole body drops 2 px on the stomp,
##   dust kicks up on every footfall and the camera gives a small nudge. None
##   of that touches the AI - the golem still walks at exactly `move_speed`
##   and its slam still covers exactly `slam_radius`.

# ---------------------------------------------------------------------------
# Sheet layout  (see tools/make_golem_sprites.py)
# ---------------------------------------------------------------------------
const ROW_FRAMES: int = 12
const WHITE_ROW_OFFSET: int = 12

## Frame indices inside row 0. Keep in sync with POSES in the generator.
enum Pose {
	IDLE_A = 0,      # hunched, fists hanging by the knees
	IDLE_B,          # breath in: chest up, seams brighter
	ROAR,            # the testosterone beat: head up, jaw open, arms flung
	WALK_A,          # stomp, left foot planted
	WALK_B,          # stomp, right foot planted
	TELEGRAPH,       # both fists overhead - the dodge window
	SLAM,            # fists driven into the floor, ground cracks
	RECOVER,         # stuck in the ground, slumped, seams dying down
	HURT,            # knocked back a step
	RISE,            # elite: arms spread, seams blazing (UPRISING)
	CRUMBLE,         # knees gone, folding sideways
	RUBBLE,          # the pile that is left behind
}

enum Mode { LOCOMOTION, TELEGRAPH, SLAM, RECOVER, HURT, ROAR, RISE, DEAD }

# ---------------------------------------------------------------------------
# Feel. Safe to tweak in the Inspector.
# ---------------------------------------------------------------------------
## Seconds per stomp frame. Long on purpose: a fast golem is a contradiction.
@export var walk_frame_time: float = 0.28
## How far the body rises between stomps, in pixels.
@export var walk_lift: float = 1.5
## How far the body DROPS on the planted foot. The drop is what sells mass.
@export var walk_drop: float = 2.0
## Camera nudge on every footfall (0 disables the footstep shake).
@export var footstep_shake: float = 1.2
@export var footstep_shake_time: float = 0.12
## Idle breathing speed (radians per second).
@export var breath_speed: float = 1.6
## How long the roar is held before it falls back to locomotion.
@export var roar_time: float = 0.7
## How long the elite flare is held before it falls back to locomotion.
@export var rise_time: float = 0.85
## How long the hurt flinch is held.
@export var hurt_time: float = 0.2
## How long the crumble pose plays before the rubble pile is left behind.
@export var crumble_time: float = 0.22
## How long the white silhouette stays on after a hit.
@export var flash_time: float = 0.1

# ---------------------------------------------------------------------------
# Nodes
# ---------------------------------------------------------------------------
@onready var body: Sprite2D = $Body
@onready var shadow: Sprite2D = $Shadow

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
var _mode: Mode = Mode.LOCOMOTION
var _pose: int = Pose.IDLE_A
var _facing: int = 1
var _moving: bool = false

var _flash_left: float = 0.0
var _mode_time: float = 0.0
var _idle_time: float = 0.0
var _walk_time: float = 0.0
var _last_step: int = -1
var _lift: float = 0.0
var _shake_x: float = 0.0


func _ready() -> void:
	_apply()


func _process(delta: float) -> void:
	_flash_left = maxf(0.0, _flash_left - delta)
	_mode_time += delta

	match _mode:
		Mode.LOCOMOTION:
			_update_locomotion(delta)
		Mode.TELEGRAPH:
			_update_telegraph()
		Mode.SLAM, Mode.RECOVER:
			_lift = 0.0
			_shake_x = 0.0
		Mode.RISE:
			_lift = 0.0
			_shake_x = 0.0
			if _mode_time >= rise_time:
				_mode = Mode.LOCOMOTION
				_mode_time = 0.0
		Mode.HURT:
			_lift = 0.0
			if _mode_time >= hurt_time:
				# A flinch ends on its own: the AI should never have to
				# remember to clear a purely cosmetic pose.
				_mode = Mode.LOCOMOTION
				_mode_time = 0.0
		Mode.ROAR:
			_lift = 0.0
			if _mode_time >= roar_time:
				_mode = Mode.LOCOMOTION
				_mode_time = 0.0
		Mode.DEAD:
			_update_dead()
		_:
			pass

	_apply()


# =====================================================================
# PUBLIC API - the only calls golem.gd is allowed to make
# =====================================================================

## Look left/right. Pass any non-zero x (the art faces RIGHT by default).
func set_facing(x: float) -> void:
	if absf(x) < 0.01:
		return
	_facing = -1 if x < 0.0 else 1


## "Am I walking right now?" Safe to call every physics frame - it only
## reacts to a real change, so it never restarts the stomp mid-step.
func set_moving(moving: bool) -> void:
	if moving == _moving:
		return
	_moving = moving
	_walk_time = 0.0
	_last_step = -1
	if not moving:
		_lift = 0.0


## The 0.8 s arm-raise. `progress` 0..1 grows the tremble as the fists climb.
func play_telegraph(progress: float = 0.0) -> void:
	if _mode != Mode.TELEGRAPH:
		_mode = Mode.TELEGRAPH
		_mode_time = 0.0
	_pose = Pose.TELEGRAPH
	# The heavier the wind-up, the more the shoulders tremble.
	_shake_x = sin(_mode_time * 38.0) * 0.8 * clampf(progress, 0.0, 1.0)


## Impact: the frame where the fists hit the floor. The floor crack, the
## dust and the shake live here, next to the pose that shows them.
func play_slam() -> void:
	_mode = Mode.SLAM
	_mode_time = 0.0
	_pose = Pose.SLAM
	_shake_x = 0.0
	_lift = 0.0
	_spawn_impact_dust()


## Stuck in the ground: the punish window. Slumped, seams dying down.
func play_recover() -> void:
	_mode = Mode.RECOVER
	_mode_time = 0.0
	_pose = Pose.RECOVER
	_shake_x = 0.0
	_lift = 0.0


## A short flinch when hit. Does not touch the game state.
func play_hurt() -> void:
	if _mode == Mode.TELEGRAPH:
		return
	_mode = Mode.HURT
	_mode_time = 0.0
	_pose = Pose.HURT
	_lift = 0.0


## The chest swells and the golem bellows. Used on spawn and after a slam.
func play_roar() -> void:
	if _mode == Mode.DEAD:
		return
	_mode = Mode.ROAR
	_mode_time = 0.0
	_pose = Pose.ROAR
	_lift = 0.0
	_shake_x = 0.0


## The elite tell: seams blaze, arms spread (elite UPRISING).
func play_rise() -> void:
	if _mode == Mode.DEAD:
		return
	_mode = Mode.RISE
	_mode_time = 0.0
	_pose = Pose.RISE
	_spawn_ember_motes()


## Crumble into a rubble pile. The node stays where it is; `golem.gd` only
## fades it out.
func play_death() -> void:
	_mode = Mode.DEAD
	_mode_time = 0.0
	_pose = Pose.CRUMBLE
	_lift = 0.0
	_shake_x = 0.0
	_spawn_rubble_burst()


## Paint the golem pure white for a moment (the hit flash).
func flash(duration: float = -1.0) -> void:
	var length: float = flash_time if duration < 0.0 else duration
	_flash_left = maxf(_flash_left, length)


## True while the white silhouette is showing.
func is_flashing() -> bool:
	return _flash_left > 0.0


## Back to plain locomotion (used when a telegraph is cancelled).
func play_idle() -> void:
	_mode = Mode.LOCOMOTION
	_mode_time = 0.0
	_walk_time = 0.0
	_lift = 0.0
	_shake_x = 0.0


# =====================================================================
# LOCOMOTION (breathing + the stomp cycle)
# =====================================================================

func _update_locomotion(delta: float) -> void:
	_idle_time += delta

	if _moving:
		_walk_time += delta
		var step: int = int(_walk_time / maxf(walk_frame_time, 0.001)) % 2
		_pose = Pose.WALK_A if step == 0 else Pose.WALK_B
		# Rise between stomps, DROP on the planted foot. `step` flips on the
		# footfall, so the drop lands exactly on the frame change.
		var phase: float = fmod(_walk_time, walk_frame_time) / maxf(walk_frame_time, 0.001)
		_lift = lerpf(walk_lift, -walk_drop, phase * phase)
		if step != _last_step:
			_last_step = step
			_on_footstep()
		return

	# Standing: a slow stone breath between the two idle frames.
	_walk_time = 0.0
	_last_step = -1
	_lift = 0.0
	var breath: float = (sin(_idle_time * breath_speed) + 1.0) * 0.5
	_pose = Pose.IDLE_B if breath > 0.5 else Pose.IDLE_A


func _update_telegraph() -> void:
	_lift = 0.0
	# Tremble instead of bounce: it is winding up, not hopping.
	_shake_x = sin(_mode_time * 38.0) * 0.9


func _update_dead() -> void:
	_lift = 0.0
	_shake_x = 0.0
	_pose = Pose.CRUMBLE if _mode_time < crumble_time else Pose.RUBBLE


## One footfall: a camera nudge and a puff of dust. This is the "heavy".
func _on_footstep() -> void:
	if footstep_shake > 0.0:
		ScreenShake.shake(footstep_shake, footstep_shake_time)
	_spawn_foot_dust()


# =====================================================================
# APPLYING THE LOOK
# =====================================================================

func _apply() -> void:
	if body == null:
		return

	body.frame = (WHITE_ROW_OFFSET if _flash_left > 0.0 else 0) + _pose
	body.flip_h = _facing < 0
	body.position = Vector2(_shake_x, -_lift)

	if shadow != null:
		var spread: float = 1.0 + clampf(-_lift / maxf(walk_drop, 0.001), 0.0, 1.0) * 0.06
		shadow.scale = Vector2(1.1, 0.32) * spread


# =====================================================================
# JUICE - dust, embers, rubble (made in code, no extra scene files)
# =====================================================================

## A short lift of grey dust at the feet on every stomp.
func _spawn_foot_dust() -> void:
	_spawn_particles(4, 0.35, Color(0.62, 0.61, 0.66, 0.75), 10.0, 30.0, 1.4, 200.0)


## The slam: a wide ring of dust kicked outward from both fists.
func _spawn_impact_dust() -> void:
	_spawn_particles(18, 0.45, Color(0.55, 0.54, 0.6, 0.85), 70.0, 150.0, 2.2, 300.0)


## Elite flare: a few amber motes rising out of the chest.
func _spawn_ember_motes() -> void:
	_spawn_particles(10, 0.7, Color(1.0, 0.7, 0.32, 0.9), 30.0, 70.0, 1.3, -40.0, 40.0)


## The crumble: a shower of rock chips.
func _spawn_rubble_burst() -> void:
	_spawn_particles(22, 0.6, Color(0.42, 0.41, 0.47, 1.0), 60.0, 140.0, 2.6, 320.0)


## One shared particle builder. `spread` 100 = a full pop in every direction,
## 40 = a narrow upward wisp (embers).
func _spawn_particles(amount: int, life: float, colour: Color,
		speed_min: float, speed_max: float, scale_max: float,
		gravity_y: float, spread: float = 100.0) -> void:
	var parent_node: Node = get_parent()
	if parent_node == null:
		return

	var burst := CPUParticles2D.new()
	burst.one_shot = true
	burst.amount = amount
	burst.lifetime = life
	burst.explosiveness = 1.0
	burst.direction = Vector2.UP
	burst.spread = spread
	burst.initial_velocity_min = speed_min
	burst.initial_velocity_max = speed_max
	burst.gravity = Vector2(0.0, gravity_y)
	burst.scale_amount_min = 1.0
	burst.scale_amount_max = scale_max
	burst.color = colour
	burst.emitting = false
	parent_node.add_child(burst)
	# Dust comes off the FLOOR, not out of the torso: that is the
	# difference between "a heavy thing landed" and "a balloon popped".
	burst.global_position = global_position + Vector2(0.0, 8.0)
	burst.emitting = true
	burst.finished.connect(burst.queue_free)
