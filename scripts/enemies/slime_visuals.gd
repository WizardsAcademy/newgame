extends Node2D
class_name SlimeVisuals
## Everything the slime LOOKS like: the 12-pose sheet, the hop cycle, the
## squash & stretch, the ground shadow + goo puddle, the white hit flash,
## the attack telegraph and the death splat.
##
## WHY THIS FILE EXISTS
##   `slime.gd` answers "what should the slime DO?" (chase, telegraph,
##   lunge, die). This file answers "what should the slime LOOK like?".
##   The two never reach into each other: the AI calls six short methods
##   (`set_facing`, `set_moving`, `play_telegraph`, `play_lunge`,
##   `play_recover`, `play_hurt`, `play_death`, `flash`) and this script
##   owns every pixel, tween and particle. A boss slime, a pet slime or a
##   training dummy can then reuse the look without copying AI code.
##
## THE SHEET (assets/textures/slime.png, generated by
## tools/make_slime_sprites.py - run that file, never hand-edit the PNG)
##   12 columns x 2 rows of 32x32 frames.
##   row 0 = the coloured poses, in the order of the `Pose` enum below
##   row 1 = the SAME poses as pure-white silhouettes
##           -> a hit flash is simply `frame += 12` for 0.1 s. No shader,
##              no second sprite node, no per-frame colour maths.
##
## WHY THE HOP IS VISUAL-ONLY
##   The slime still slides toward the player with the plain velocity from
##   `_chase_player()` (the AI tests depend on that exact 40 px/s crawl).
##   Only the SPRITE rises, squashes and lands - the collision capsule
##   never leaves the ground, so combat, stop distance and the physics
##   tests all behave exactly as before.

# ---------------------------------------------------------------------------
# Sheet layout
# ---------------------------------------------------------------------------
const WHITE_ROW_OFFSET: int = 12

## Frame indices inside row 0. Keep in sync with POSES in the generator.
enum Pose {
	IDLE_A = 0,      # resting dome, "breath out"
	IDLE_B,          # resting dome, "breath in"
	BLINK,           # eyes closed, same shape as IDLE_A
	CROUCH,          # gathering for a hop: wide + low
	AIR_UP,          # rising: stretched tall
	AIR_DOWN,        # falling: a little wider again
	LAND,            # splat: widest, shortest pose
	TELEGRAPH,       # attack wind-up: low, leaning back, angry brows
	LUNGE,           # attack: long, leaning in, shouting
	HURT,            # taking a hit: flinch + sweat drop
	SETTLE,          # rebound after a landing
	PUDDLE,          # death: flattened goo
}

## What the visual state machine is doing. LOCOMOTION is the only state
## that runs the hop/idle loop; the others hold a single pose until the
## AI says otherwise.
enum Mode { LOCOMOTION, TELEGRAPH, LUNGE, HURT, DEAD }

# ---------------------------------------------------------------------------
# Feel. All of these are safe to tweak in the Inspector.
# ---------------------------------------------------------------------------
## Airtime of one visual hop, in seconds.
@export var hop_duration: float = 0.30
## Squash before take-off.
@export var crouch_duration: float = 0.10
## Splat after landing.
@export var land_duration: float = 0.12
## Peak height of the hop, in pixels (the art is ~24 px tall).
@export var hop_height: float = 6.0
## How long the white silhouette stays on after a hit.
@export var flash_time: float = 0.1
## Idle breathing speed (radians per second, roughly).
@export var breath_speed: float = 2.4
## Blink interval range, in seconds.
@export var blink_min: float = 2.2
@export var blink_max: float = 5.2
## How long the hurt pose is held before the slime returns to normal.
@export var hurt_time: float = 0.16
## Tint + size of the "hero" version of the slime (gold ring aside).
@export var elite_tint: Color = Color(1.06, 1.04, 0.84)
@export var elite_scale: float = 1.08

# ---------------------------------------------------------------------------
# Nodes
# ---------------------------------------------------------------------------
@onready var body: Sprite2D = $Body
@onready var shadow: Sprite2D = $Shadow
@onready var puddle: Sprite2D = $Puddle

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
var _mode: Mode = Mode.LOCOMOTION
var _pose: int = Pose.IDLE_A
var _facing: int = 1
var _moving: bool = false

## Time inside the current hop cycle, and which of the 3 stages we are in
## (-1 = not hopping, 0 = crouch, 1 = airborne, 2 = landing).
var _cycle: float = 0.0
var _stage: int = -1

## Current lift off the ground and squash (<0 = stretched, >0 = squashed).
var _height: float = 0.0
var _squash: float = 0.0
## Horizontal tremble offset (only the telegraph uses it).
var _shake_x: float = 0.0
var _tint: Color = Color.WHITE

var _flash_left: float = 0.0
var _mode_time: float = 0.0
var _idle_time: float = 0.0
var _blink_in: float = 3.0
var _blink_left: float = 0.0
var _is_elite: bool = false
var _goo_color: Color = Color("6ec866")


func _ready() -> void:
	# A random first blink so a wave of slimes does not blink in lockstep.
	_blink_in = randf_range(blink_min, blink_max)
	_apply()


func _process(delta: float) -> void:
	_flash_left = maxf(0.0, _flash_left - delta)
	_mode_time += delta

	match _mode:
		Mode.LOCOMOTION:
			_update_locomotion(delta)
		Mode.TELEGRAPH:
			_update_telegraph()
		Mode.LUNGE:
			_update_lunge()
		Mode.HURT:
			_update_hurt()
		Mode.DEAD:
			_update_dead()

	_apply()


# =====================================================================
# PUBLIC API - the only calls slime.gd is allowed to make
# =====================================================================

## Look left/right. Pass any non-zero x (the sprite only has two sides).
func set_facing(x: float) -> void:
	if absf(x) < 0.01:
		return
	_facing = -1 if x < 0.0 else 1


## "Am I walking right now?" - toggles the hop cycle on and off.
## Safe to call every physics frame; it only reacts to a real change.
func set_moving(moving: bool) -> void:
	if moving == _moving:
		return
	_moving = moving
	_cycle = 0.0
	_stage = -1
	_shake_x = 0.0
	if not moving:
		_height = 0.0
		_squash = 0.0


## Attack wind-up: gather low, lean back, glow red, tremble.
func play_telegraph() -> void:
	_mode = Mode.TELEGRAPH
	_mode_time = 0.0
	_cycle = 0.0
	_stage = -1
	_set_pose(Pose.TELEGRAPH)


## The spring: long body, leaning into the direction of travel.
func play_lunge() -> void:
	_mode = Mode.LUNGE
	_mode_time = 0.0
	_set_pose(Pose.LUNGE)


## Back to normal after a lunge / a cancelled wind-up.
func play_recover() -> void:
	_mode = Mode.LOCOMOTION
	_mode_time = 0.0
	_cycle = 0.0
	_stage = -1
	_shake_x = 0.0
	_tint = Color.WHITE


## A short flinch (the AI still does the maths; this is only the face).
func play_hurt() -> void:
	_mode = Mode.HURT
	_mode_time = 0.0
	_set_pose(Pose.HURT)


## Flatten into a puddle, spit goo everywhere, leave a decal behind.
func play_death() -> void:
	_mode = Mode.DEAD
	_mode_time = 0.0
	_set_pose(Pose.PUDDLE)
	_tint = Color.WHITE
	_spawn_death_burst()
	_spawn_goo_decal()


## Paint the slime pure white for a moment (the hit flash).
func flash(duration: float = -1.0) -> void:
	var length: float = flash_time if duration < 0.0 else duration
	_flash_left = maxf(_flash_left, length)


## True while the white silhouette is showing.
func is_flashing() -> bool:
	return _flash_left > 0.0


## The spawner's "hero" version: slightly bigger, warmer tint.
func become_elite() -> void:
	_is_elite = true


## Colour of this slime's goo (droplets + death splat). The body art keeps
## its baked palette; only the wet stuff follows the Inspector value, so a
## blue "toxic" slime is still one exported colour away.
func set_goo_color(colour: Color) -> void:
	_goo_color = colour


# =====================================================================
# LOCOMOTION (idle breathing + hop cycle)
# =====================================================================

func _update_locomotion(delta: float) -> void:
	_shake_x = 0.0
	_tint = _tint.lerp(Color.WHITE, clampf(delta * 8.0, 0.0, 1.0))
	_idle_time += delta

	if _moving:
		_blink_left = 0.0
		var total: float = crouch_duration + hop_duration + land_duration
		_cycle += delta
		var t: float = fmod(_cycle, total)

		if t < crouch_duration:
			# 1) gather: the classic anticipation squash
			var p: float = t / maxf(crouch_duration, 0.001)
			_set_pose(Pose.CROUCH)
			_height = 0.0
			_squash = sin(p * PI) * 0.08
			_stage = 0
		elif t < crouch_duration + hop_duration:
			# 2) airborne: the body stretches as it rises, relaxes at the top
			var p: float = (t - crouch_duration) / maxf(hop_duration, 0.001)
			_set_pose(Pose.AIR_UP if p < 0.55 else Pose.AIR_DOWN)
			_height = sin(p * PI) * hop_height
			_squash = -0.05 * sin(p * PI)
			_stage = 1
		else:
			# 3) landing: splat, then spring back to the resting dome
			var p: float = (t - crouch_duration - hop_duration) / maxf(land_duration, 0.001)
			_set_pose(Pose.LAND if p < 0.45 else Pose.SETTLE)
			_height = 0.0
			_squash = (1.0 - p) * 0.10
			if _stage == 1:
				_spawn_land_puff()
			_stage = 2
	else:
		# Idle: a slow breath plus the occasional blink. Nothing else moves,
		# so a sleeping slime is unmistakably asleep.
		_stage = -1
		_cycle = 0.0
		_height = 0.0
		var breath: float = (sin(_idle_time * breath_speed) + 1.0) * 0.5
		_squash = breath * 0.03
		_set_pose(Pose.IDLE_B if breath > 0.5 else Pose.IDLE_A)

		_blink_in -= delta
		if _blink_left > 0.0:
			_blink_left -= delta
			_set_pose(Pose.BLINK)
		elif _blink_in <= 0.0:
			_blink_left = 0.1
			_blink_in = randf_range(blink_min, blink_max)


# =====================================================================
# ATTACK POSES
# =====================================================================

func _update_telegraph() -> void:
	_height = 0.0
	# Gathering harder and harder, with a nervous tremble on top: the
	# player reads "it is about to jump" long before the lunge starts.
	_squash = 0.07 + 0.015 * sin(_mode_time * 34.0)
	_tint = Color(1.0, 0.62, 0.62)
	_shake_x = sin(_mode_time * 52.0) * 0.8


func _update_lunge() -> void:
	_squash = -0.05
	_height = 2.0
	_tint = Color.WHITE
	_shake_x = 0.0


func _update_hurt() -> void:
	_height = 0.0
	var t: float = clampf(_mode_time / maxf(hurt_time, 0.001), 0.0, 1.0)
	# Flinch fast, recover slower: (1-t)^2 is snappy at the start.
	_squash = (1.0 - t) * (1.0 - t) * 0.08
	_shake_x = 0.0
	if _mode_time >= hurt_time:
		_mode = Mode.LOCOMOTION
		_mode_time = 0.0


func _update_dead() -> void:
	_height = 0.0
	_squash = lerpf(0.12, 0.0, clampf(_mode_time / 0.18, 0.0, 1.0))
	_shake_x = 0.0


# =====================================================================
# APPLYING THE LOOK
# =====================================================================

func _set_pose(pose: int) -> void:
	_pose = pose


## Writes the state onto the nodes. Called once per rendered frame - never
## per physics frame - so the motion stays smooth even if physics ticks.
func _apply() -> void:
	if body == null:
		return

	# 1) frame: the white row is exactly 12 frames down the sheet.
	body.frame = _pose + (WHITE_ROW_OFFSET if _flash_left > 0.0 else 0)
	body.flip_h = _facing < 0

	# 2) lift + squash & stretch (volume-ish preserving: what grows one way
	#    shrinks the other, which is what makes jelly feel like jelly).
	body.position = Vector2(_shake_x, -_height)
	var stretch: float = clampf(_height / maxf(hop_height, 0.001), 0.0, 1.0)
	var scale_x: float = 1.0 + _squash - 0.06 * stretch
	var scale_y: float = 1.0 - _squash + 0.10 * stretch
	if _is_elite:
		scale_x *= elite_scale
		scale_y *= elite_scale
	body.scale = Vector2(scale_x, scale_y)
	body.self_modulate = elite_tint if _is_elite else _tint

	# 3) the shadow shrinks and fades as the body rises - the cheapest,
	#    most readable way to sell height in a top-down 2D game.
	shadow.scale = Vector2.ONE * lerpf(1.0, 0.72, stretch)
	var shadow_tint: Color = shadow.modulate
	shadow_tint.a = lerpf(0.55, 0.20, stretch)
	shadow.modulate = shadow_tint

	# 4) the wet goo base: barely there while hopping, strongest on death.
	var grounded: float = 1.0 - stretch
	var puddle_alpha: float = lerpf(0.22, 0.45, grounded)
	if _mode == Mode.DEAD:
		puddle_alpha = 0.85
	var puddle_tint: Color = puddle.modulate
	puddle_tint.a = puddle_alpha
	puddle.modulate = puddle_tint
	puddle.scale = Vector2(1.0 + _squash * 0.9, 1.0 + _squash * 0.5)
	puddle.position.y = -1.0


# =====================================================================
# JUICE - particles and decals made in code (no extra scene files)
# =====================================================================

## Two or three droplets kicked up by a wet landing.
func _spawn_land_puff() -> void:
	var puff_colour: Color = _goo_color.lightened(0.25)
	puff_colour.a = 0.75
	_spawn_particles(3, 0.28, puff_colour, 26.0, 52.0, 65.0, 210.0)


## The full "goo pops" burst when the slime dies.
func _spawn_death_burst() -> void:
	_spawn_particles(16, 0.5, _goo_color.darkened(0.1),
		55.0, 140.0, 180.0, 240.0)


## One shared particle builder (same property names as the old
## `_spawn_death_burst` in slime.gd, so they are known-good).
## `spread` 180 = a full pop in every direction, 65 = an upward fan.
func _spawn_particles(amount: int, life: float, colour: Color,
		speed_min: float, speed_max: float, spread: float,
		gravity_y: float) -> void:
	var parent: Node = get_parent()
	if parent == null:
		return

	var burst := CPUParticles2D.new()
	burst.one_shot = true
	burst.amount = amount
	burst.lifetime = life
	burst.explosiveness = 1.0
	burst.direction = Vector2.UP
	burst.spread = spread
	burst.gravity = Vector2(0.0, gravity_y)
	burst.initial_velocity_min = speed_min
	burst.initial_velocity_max = speed_max
	burst.scale_amount_min = 1.0
	burst.scale_amount_max = 2.5
	burst.color = colour
	burst.emitting = false
	parent.add_child(burst)
	# Goo comes out of the wet base at the feet, not out of the creature's
	# centre - that is the difference between "popped" and "floating".
	burst.global_position = puddle.global_position if puddle != null else global_position
	burst.emitting = true
	burst.finished.connect(burst.queue_free)


## A flat goo splat that stays on the floor for a moment after the slime
## pops. Parented to the arena (not to us): we are about to be freed.
func _spawn_goo_decal() -> void:
	var parent: Node = get_parent()
	if parent == null or puddle == null or puddle.texture == null:
		return

	var decal := Sprite2D.new()
	decal.texture = puddle.texture
	decal.scale = Vector2(0.7, 0.7)
	decal.modulate = Color(1.0, 1.0, 1.0, 0.85)
	parent.add_child(decal)
	decal.global_position = puddle.global_position

	var tween := decal.create_tween()
	tween.set_parallel(true)
	tween.tween_property(decal, "scale", Vector2(1.3, 1.15), 1.1) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(decal, "modulate:a", 0.0, 0.9).set_delay(0.5)
	# Bind the cleanup to the DECAL, not to `self`: the slime is queue_free()d
	# 0.3 s after dying, and an `await` in a freed script never resumes.
	tween.finished.connect(decal.queue_free)
